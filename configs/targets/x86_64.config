# =============================================================
# Platform: x86_64 — PCs, soft routers, VMs (Proxmox/ESXi/QEMU)
# Images: squashfs/ext4 × BIOS/UEFI
# =============================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_IMAGES_GZIP=y

# Manual root partition expansion on larger disks
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y

# QEMU guest agent for Proxmox/QEMU (clean shutdown, IP shown in PVE).
# Disabled automatically at first boot when not running in a VM.
CONFIG_PACKAGE_qemu-ga=y
