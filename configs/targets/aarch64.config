# =============================================================
# Platform: aarch64 — generic ARM64 UEFI (armsr/armv8)
#
# For ARM64 *virtual machines* and UEFI servers: Proxmox on ARM,
# UTM/QEMU on Apple Silicon, cloud ARM instances.
# NOT for NanoPi / Raspberry Pi boards — they have no UEFI firmware;
# use the rockchip / rpi4 / rpi5 images instead.
# =============================================================
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_IMAGES_GZIP=y

# QEMU guest agent (disabled automatically when not in a VM)
CONFIG_PACKAGE_qemu-ga=y
